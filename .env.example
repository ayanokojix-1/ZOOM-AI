# Telegram: create a bot with @BotFather (one bot per customer)
TELEGRAM_BOT_TOKEN=
# Any long random string (e.g. `openssl rand -hex 32`). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Secret passphrase the customer sends as `/login <code>` to unlock the bot.
ACCESS_CODE=

GEMINI_API_KEY=

# The customer's Zoom Server-to-Server OAuth app (marketplace.zoom.us > Develop > Build App)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Shared Postgres for all customers (rows are separated by bot). Neon: use the *pooled*
# connection string (host has "-pooler"). Tables are created automatically on first use.
DATABASE_URL=

# Timezone used when the customer doesn't name one (IANA name)
TIMEZONE=Africa/Tunis

# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite
